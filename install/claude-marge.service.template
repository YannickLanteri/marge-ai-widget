[Unit]
Description=Marge AI Widget
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Electron cannot position windows under Wayland, so force X11.
Environment=ELECTRON_OZONE_PLATFORM_HINT=x11
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/bin/run-widget
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
